# Target group/channel username or invite link (required)
# Examples: https://t.me/examplegroup, @examplegroup, examplegroup, or t.me/examplegroup
TARGET=https://t.me/examplegroup

# Scraping mode: 'messages' (conversation history), 'members' (member list), or 'both' (default: both)
SCRAPE_MODE=both

# Maximum number of conversation messages to inspect for active members (default: 5000)
MESSAGE_LIMIT=5000

# Camofox browser server endpoint (default: http://127.0.0.1:9377)
CAMOFOX_URL=http://127.0.0.1:9377

# Optional API key for Camofox authentication if enabled
CAMOFOX_API_KEY=

# Persistent Camofox user profile ID (retains Telegram Web login session across runs)
CAMOFOX_USER_ID=tg-scraper-user

# Output CSV file path (default: participants.csv)
CSV_OUTPUT=participants.csv

# Maximum virtual scroll iterations before stopping (default: 100)
SCROLL_MAX_ITERATIONS=100

# Stop after N consecutive scrolls with no new members found (default: 5)
SCROLL_IDLE_LIMIT=5
